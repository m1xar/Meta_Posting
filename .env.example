APP_ENV=development
HTTP_ADDRESS=:8080
HOST_HTTP_PORT=8080
DATABASE_URL=postgres://raze_posting:replace-with-the-same-long-random-password@postgres:5432/raze_posting?sslmode=disable
POSTGRES_DB=raze_posting
POSTGRES_USER=raze_posting
POSTGRES_PASSWORD=replace-with-the-same-long-random-password
UPLOADS_DIR=/var/lib/raze-posting/uploads
INTERNAL_API_TOKEN=replace-with-a-long-random-token
# The shared token above reads every tenant and owns nothing. It stays off by
# default; per-user API keys (POST /v1/api-keys) replace it. Enable only while
# migrating existing callers.
ALLOW_LEGACY_INTERNAL_TOKEN=false
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=https://api.terahash.win/oauth/facebook/callback
META_LOGIN_CONFIG_ID=1560584762511591
META_OAUTH_SCOPES=ads_management,ads_read,business_management,pages_show_list,pages_read_engagement
META_REQUEST_TIMEOUT=30s
META_UPLOAD_TIMEOUT=30m

WORKER_POLL_INTERVAL=2s
WORKER_CONCURRENCY=4
INSIGHTS_POLL_INTERVAL=15m
GUARD_EVALUATION_INTERVAL=5m
JOB_LEASE_DURATION=5m
JOB_MAX_ATTEMPTS=5

# Account-wide insights tracking.
# Cadence falls off with cost: an account-level poll is one row per day, an
# ad-level poll is one row per ad per day, so ad level rotates through
# INSIGHTS_AD_LEVEL_BATCH accounts per cycle instead of polling all of them.
# Re-runs ad account discovery. Without it a connection is only discovered
# once, at OAuth time: an ad account granted later stays invisible and
# account_status goes stale, which incremental polling depends on.
DISCOVERY_INTERVAL=6h

# Rules may ask to run every 60s. The scheduler ticks rules and their insight
# collection on this cadence for connections holding such a rule - evaluating
# a minute-rule against 15-minute-old numbers is a stale decision made more
# often, so both halves move together.
FAST_RULE_LANE_INTERVAL=1m

# Keitaro tracker (leave empty to disable per-campaign reg/deposit stats)
KEITARO_BASE_URL=https://ctrconversation.pro
KEITARO_API_KEY=
KEITARO_POLL_INTERVAL=10m
KEITARO_REQUEST_TIMEOUT=30s
FAST_RULE_MAX_INTERVAL_SECONDS=300
INSIGHTS_ENTITY_SYNC_INTERVAL=6h
INSIGHTS_ACCOUNT_INTERVAL=15m
INSIGHTS_CAMPAIGN_INTERVAL=30m
INSIGHTS_ADSET_INTERVAL=2h
INSIGHTS_AD_INTERVAL=6h
INSIGHTS_AD_LEVEL_BATCH=25

# 28 because 28d_click is Meta's longest standard attribution window: a
# conversion attributed to day D can still arrive 28 days later.
INSIGHTS_LOOKBACK_DAYS=28
# Capped at 1100 - Meta retains insights for 37 months.
INSIGHTS_BACKFILL_DAYS=90
# Must be at least twice the lookback, so a retention sweep cannot delete
# history the automation rules still read.
INSIGHTS_RETENTION=2160h
INSIGHTS_RETENTION_INTERVAL=1h
WORKER_MAINTENANCE_INTERVAL=1m
