APP_ENV=development
HTTP_ADDRESS=:8080
HOST_HTTP_PORT=8080
DATABASE_URL=postgres://raze_posting:replace-with-the-same-long-random-password@postgres:5432/raze_posting?sslmode=disable
POSTGRES_DB=raze_posting
POSTGRES_USER=raze_posting
POSTGRES_PASSWORD=replace-with-the-same-long-random-password
UPLOADS_DIR=/var/lib/raze-posting/uploads
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v25.0
META_OAUTH_REDIRECT_URI=https://api.terahash.win/oauth/facebook/callback
META_LOGIN_CONFIG_ID=1560584762511591
META_OAUTH_SCOPES=ads_management,ads_read,business_management,pages_show_list,pages_read_engagement
META_REQUEST_TIMEOUT=30s
META_UPLOAD_TIMEOUT=30m

WORKER_POLL_INTERVAL=2s
WORKER_CONCURRENCY=4
INSIGHTS_POLL_INTERVAL=15m
GUARD_EVALUATION_INTERVAL=5m
JOB_LEASE_DURATION=5m
JOB_MAX_ATTEMPTS=5

# Keitaro tracker (leave empty to disable per-campaign lead/deposit stats)
KEITARO_BASE_URL=https://ctrconversation.pro
KEITARO_API_KEY=
KEITARO_POLL_INTERVAL=10m
KEITARO_REQUEST_TIMEOUT=30s
